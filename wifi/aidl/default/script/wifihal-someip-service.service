[Unit]
Description=wifihal-someip-service
After=multi-user.target someip-central-router.service

[Service]
User=root
Group=root
Type=simple
ExecStartPre=/bin/sh /usr/bin/ip_config_wlan.sh vlan
ExecStart=/usr/bin/wifihal-someip-service
ExecStop=/bin/kill -INT $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target